      "dark": "blueSoft",
      "light": "lblue"
    },
    "markdownLinkText": {
      "dark": "blue",
      "light": "lblueDeep"
    },
    "markdownCode": {
      "dark": "teal",
      "light": "lteal"
    },
    "markdownBlockQuote": {
      "dark": "label2",
      "light": "llabel2"
    },
    "markdownEmph": {
      "dark": "label",
      "light": "llabel"
    },
    "markdownStrong": {
      "dark": "orange",
      "light": "lorange"
    },
    "markdownHorizontalRule": {
      "dark": "separator",
      "light": "lseparator"
    },
    "markdownListItem": {
      "dark": "label2",
      "light": "llabel2"
    },
    "markdownListEnumeration": {
      "dark": "label2",
      "light": "llabel2"
    },
    "markdownImage": {
      "dark": "blueSoft",
      "light": "lblue"
