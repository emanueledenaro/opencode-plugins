  "theme": {
    "primary": {
      "dark": "blue",
      "light": "lblue"
    },
    "secondary": {
      "dark": "indigo",
      "light": "lindigo"
    },
    "accent": {
      "dark": "blue",
      "light": "lblue"
    },
    "error": {
      "dark": "red",
      "light": "lred"
    },
    "warning": {
      "dark": "orange",
      "light": "lorange"
    },
    "success": {
      "dark": "green",
      "light": "lgreen"
    },
    "info": {
      "dark": "teal",
      "light": "lteal"
    },
    "text": {
      "dark": "label",
      "light": "llabel"
    },
