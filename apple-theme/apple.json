      "dark": "label3",
      "light": "llabel3"
    },
    "syntaxKeyword": {
      "dark": "pink",
      "light": "lpink"
    },
    "syntaxFunction": {
      "dark": "teal",
      "light": "lteal"
    },
    "syntaxVariable": {
      "dark": "label",
      "light": "llabel"
    },
    "syntaxString": {
      "dark": "orange",
      "light": "lorange"
    },
    "syntaxNumber": {
      "dark": "yellow",
      "light": "lyellow"
    },
    "syntaxType": {
      "dark": "purple",
      "light": "lpurple"
    },
    "syntaxOperator": {
      "dark": "label2",
      "light": "llabel2"
    },
    "syntaxPunctuation": {
      "dark": "label2",
      "light": "llabel2"
    }
