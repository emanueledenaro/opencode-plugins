    "llabel3": "#a1a1a6",
    "lblue": "#007aff",
    "lblueDeep": "#0060df",
    "lgreen": "#248a3d",
    "lred": "#d70015",
    "lorange": "#c93400",
    "lyellow": "#a05a00",
    "lpurple": "#8944ab",
    "lpink": "#d30f45",
    "lteal": "#0071a4",
    "lindigo": "#3634a3",
    "ldiffAddBg": "#e3f6e8",
    "ldiffDelBg": "#fde8e7"
