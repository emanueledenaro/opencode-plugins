    "bgElement": "#3a3a3c",
    "bgHigh": "#3a3a3c",
    "separator": "#545458",
    "label": "#f0ede6",
    "label2": "#98989d",
    "label3": "#636366",
    "blue": "#0a84ff",
    "blueSoft": "#64a8ff",
    "green": "#30d158",
    "red": "#ff453a",
    "orange": "#ff9f0a",
    "yellow": "#ffd60a",
    "purple": "#bf5af2",
    "pink": "#ff375f",
    "teal": "#64d2ff",
    "indigo": "#7d7aff",
    "diffAddBg": "#13291a",
    "diffDelBg": "#2e1513",
    "lbg": "#ffffff",
    "lbgPanel": "#f2f2f7",
    "lbgElement": "#e5e5ea",
    "lbgHigh": "#e1e1e6",
    "lseparator": "#c6c6c8",
    "llabel": "#1d1d1f",
